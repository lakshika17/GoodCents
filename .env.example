# =============================================================================
# GoodCents — environment variable template
# =============================================================================
# This file is a TEMPLATE for contributors running an offline/local copy.
# It contains placeholder values only — no real secrets.
#
# Setup:
#   1. Copy this file to `.env.local`  (cp .env.example .env.local)
#   2. Fill in your own values in `.env.local`
#   3. `.env.local` is git-ignored (via `*.local`) and will never be committed
#
# The project already ships a committed `.env` with the public Supabase
# publishable keys below. Do NOT edit or delete that file — `.env.local`
# only needs to override or add the values you change.
# =============================================================================

# --- Backend / Database (Lovable Cloud) --------------------------------------
# Public publishable keys — safe to expose in the browser. Already present in
# the committed `.env`; only copy these into `.env.local` if you need to point
# at a different backend.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- AI receipt extraction (server-only, never exposed to the browser) -------
# Primary provider: OpenRouter (DeepSeek). Get a key at openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# If unset, extraction falls back to Lovable AI (hosted workspace only).

# --- PayPal Sandbox payouts (server-only) ------------------------------------
# From developer.paypal.com -> Apps & Credentials (Sandbox toggle ON).
# Use the REST app of your US Business sandbox account with Payouts enabled.
PAYPAL_SANDBOX_CLIENT_ID="your_sandbox_client_id"
PAYPAL_SANDBOX_CLIENT_SECRET="your_sandbox_client_secret"

# Sandbox Personal account email that receives demo reimbursement payouts.
# Must be a @personal.example.com sandbox address, NOT a real email.
DEMO_PAYPAL_RECEIVER_EMAIL="sb-xxxx@personal.example.com"
